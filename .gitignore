# Dependencias y builds
node_modules/
dist/
*.tsbuildinfo

# Tests
coverage/
playwright-report/
test-results/
blob-report/

# Datos geográficos crudos: se restauran del snapshot (`npm run map:prepare`) o se vuelven a bajar con `npm run map:fetch`
data/geographic/raw/

# El mapa que se deriva al construir (`npm run map:prepare`): teselas, edificios de las plazas y mallas 3D.
# Lo demás de public/map (vías, suelo, relieve) sale de datos que no cambian al editar una plaza.
/public/map/zibata.pmtiles
/public/map/plaza-buildings.geojson
/public/map/realismo/edificios.bin
/public/map/realismo/arboles.bin

# Originales de fotografías (se publican solo las versiones optimizadas)
data/commercial/photos-src/

# Entorno y editores
.env
.env.*
!.env.example
# Secretos de `wrangler dev` (GITHUB_TOKEN para probar commits reales). Nunca se versionan.
.dev.vars
.dev.vars.*
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.log

# Configuración local de agentes (no forma parte del producto)
.claude/
# Inventario de las habilidades instaladas con "npx skills": acompaña a .claude/skills,
# que tampoco se versiona, asi que versionarlo describiria archivos que nadie mas tiene.
skills-lock.json

# Estado local de wrangler (base D1 de desarrollo, cachés).
.wrangler/

# Material auxiliar e interno: no hace falta para que la página funcione, así que no se publica.
# Sigue en local y hay copia fuera del repositorio.
/CLAUDE.md
/AGENTS.md
/DESIGN.md
/CONTRIBUTING.md
/SECURITY.md
/CHANGELOG.md
/.impeccable/
/docs/
/research/*.md
/data/research/README.md

# Investigación, bitácoras y auditorías: material interno, no hace falta para que la guía funcione ni
# para sus pruebas. Siguen en local y hay copia fuera del repositorio. Solo `closed.json` queda
# versionado porque una prueba lo lee.
/research/
/data/research/*
!/data/research/closed.json
/data/commercial/imports/
/scripts/research/apply-owner-review.ts
/scripts/research/build-dataset.ts
/.editorconfig
/.env.example
