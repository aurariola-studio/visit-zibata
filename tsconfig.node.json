{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    /* DOM: tipos para el código que Playwright evalúa dentro del navegador (tests E2E, OG). */
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Node (type stripping) mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /*
   * `src/vite-env.d.ts` entra aquí porque vite.config.ts importa la regla de rutas de
   * `src/lib/url-state.ts` (una sola fuente de verdad para app y build), y eso arrastra módulos de
   * la aplicación que usan `import.meta.env`.
   */
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "tests/e2e/**/*.ts",
    "worker/**/*.ts",
    "src/vite-env.d.ts"
  ]
}
