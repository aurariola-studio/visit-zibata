# Copia este archivo como .env.local y rellena lo que necesites. Nada de esto es secreto: Vite
# incrusta las variables VITE_* en el JavaScript que se publica, así que son públicas por diseño.

# Clave pública de Web3Forms, el servicio que entrega por correo lo que se envía desde
# "Sugiere un cambio". El correo de destino vive en Web3Forms, no aquí. Sin clave, la guía no dibuja
# el formulario. Ver docs/SEGURIDAD.md.
VITE_WEB3FORMS_KEY=

# "true" para incluir el modo de depuración del mapa en un build de producción.
VITE_ENABLE_MAP_DEBUG=
