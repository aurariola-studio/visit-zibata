{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "object",
            "properties": {
              "es": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "es"
            ],
            "additionalProperties": false
          },
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "hue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 359
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "synonyms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "giros": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": {
                  "type": "object",
                  "properties": {
                    "es": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "es"
                  ],
                  "additionalProperties": false
                },
                "icon": {
                  "type": "string",
                  "minLength": 1
                },
                "synonyms": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "general": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "label",
                "icon",
                "synonyms"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "icon",
          "order",
          "synonyms",
          "giros"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "updatedAt",
    "categories"
  ],
  "additionalProperties": false
}
